# Copy to .env.email on the server (same folder as docker-compose.yml), fill in,
# then: docker compose up -d --no-deps --no-build web
# Never commit .env.email.
#
# Example for Gmail (needs an App Password: Google Account > Security > App passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=Mendel,MD <you@gmail.com>
